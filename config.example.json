{
  "ws": {
    "host": "127.0.0.1",
    "port": 8022,
    "path": "/ssh",
    "tls": {
      "cert": "./certs/server.crt",
      "key": "./certs/server.key",
      "minVersion": "TLSv1.3"
    }
  },
  "auth": {
    "tokens": ["REPLACE_WITH_OUTPUT_OF_mikissh_gen-token"],
    "maxAttempts": 5,
    "windowMs": 60000,
    "required": true
  },
  "ssh": {
    "host": "127.0.0.1",
    "port": 22,
    "username": "root",
    "privateKey": "./.ssh/id_ed25519",
    "keepaliveIntervalMs": 15000,
    "readyTimeoutMs": 20000
  },
  "security": {
    "allowedOrigins": [],
    "requireOrigin": false,
    "idleTimeoutMs": 600000,
    "handshakeTimeoutMs": 10000,
    "maxSessions": 32,
    "maxSessionsPerIp": 4
  },
  "log": { "level": "info" }
}
